if ARCH_XM580

menu "xm580 board feature"

config MACH_XM580
	bool "Support xm580 platform"
	select CPU_V7
	select ARM_GIC
	select ARM_TIMER_SP804
	select COMMON_CLK 
	select PL330
	select DMA_SHARED_BUFFER
	select HAVE_ARM_TWD
	help
	  Includes support for the  xm580 platform.

	  This includes specific configurations for the module and
	  its peripherals.

config XM580_RTC
	bool "Add support for XM 580 RTC"
	default "y"
	help
	  Includes support for the xm580 RTC device.

config XM580_VO
	bool "Add support for XM 580 Video Output"
	default "y"
	help
	  Includes support for the xm580 VO device.

config XM580_AUDIO
	bool "Add support for XM 580 Audio Output"
	default "y"
	help
	  Includes support for the xm580 Audio device.

config MXC_HANTRO
	bool "Add support for video encoder"
	default "y"
	help
	  Includes support for the xm580 video encoder device.

config USB_DWCOTG
	bool "Add support for DWC USB controller"
	default "y"
	help
	  Includes support for the xm580 DWC 2 usb controller

menuconfig NETDEV_1000
	bool "Ethernet (1000 Mbit)"
	depends on !UML
	default y
	---help---
	  Ethernet (also called IEEE 802.3 or ISO 8802-2) is the most common
	  type of Local Area Network (LAN) in universities and companies.

	  Say Y here to get to see options for Gigabit Ethernet drivers.
	  This option alone does not add any kernel code.
	  Note that drivers supporting both 100 and 1000 MBit may be listed
	  under "Ethernet (10 or 100MBit)" instead.

	  If you say N, all options in this submenu will be skipped and disabled.

if NETDEV_1000

	source "drivers/net/xmmac/Kconfig"

endif

endmenu

endif
