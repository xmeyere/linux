/dts-v1/;
#include "skeleton.dtsi"
#include <dt-bindings/interrupt-controller/arm-gic.h>


/ {
    model = "XM580 compatible board";
    compatible = "xmeye,8536d";
    interrupt-parent = <&gic>;

    aliases {
        serial0 = &uart0;
		
	};

    memory {
        device_type = "memory";
        reg = <0x80000000 0x10000000>;
    };
    
    cpus {
        #address-cells = <1>;
		#size-cells = <0>;
        cpu@0 {
            compatible = "arm,cortex-a9";
            device_type = "cpu";
			reg = <0>;
        };
        cpu@1 {
            compatible = "arm,cortex-a9";
            device_type = "cpu";
			reg = <1>;
        };
    };

    pclk: pclk@0 {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
	};

    uartclk: uartclk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
	};

    sp804clk: sp804clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
	};

    dmaclk: dmaclk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
	};

    twdclock: twdclock {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <100000000>; // 100 MHz
	};

    soc: soc {
        #address-cells = <1>;
		#size-cells = <1>;
        compatible = "simple-bus";

        /* child and parent address space 1:1 mapped */
        ranges;

        /* Main timer (per-cpu local timer and watchdog).*/
        twd: local_timer@0200600 {
            compatible = "arm,cortex-a9-twd-timer";
			reg = <0x20200600 0x20>;
			interrupts = <0 29 0>;
            clocks = <&twdclock>;
            clock-names = "smp_twd";
		};

        timer0: timer0@100C0000 {
			compatible = "arm,sp804", "arm,primecell";
			reg = <0x100C0000 0x1000>;
			interrupts = <0 4 0>, <0 4 0>;
			clocks = <&sp804clk>;
			clock-names = "apb_pclk";
		};

        amba {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "arm,amba-bus";
			ranges;

            
            
            gic: interrupt-controller@20201000 {
                compatible = "arm,cortex-a9-gic";
                interrupt-controller;
                #interrupt-cells = <3>;
                #address-cells = <0>;
                /*  gic dist base, gic cpu base*/
                reg = <0x20201000 0xF00>, <0x20200100 0xF00>; //cpu
            };

           
			

            l2-cache-controller@20210000 {
	    	    compatible = "arm,pl310-cache";
	    	    reg = <0x20210000 0x1000>;
	    	    cache-unified;
	    	    cache-level = <2>;
	        };

            uart0: serial@10030000 {
                compatible = "arm,pl011", "arm,primecell";
                reg = <0x10030000 0x1000>;
                clocks = <&uartclk>;
                clock-names = "apb_pclk";
                interrupts = <0 0 0>;
            };

            /*uart1: serial@10040000 {
                compatible = "arm,pl011", "arm,primecell";
                reg = <0x10040000 0x1000>;
                clocks = <&pclk>;
                clock-names = "apb_pclk";
                interrupts = <0 2 0>;
            };

            uart2: serial@10050000 {
                compatible = "arm,pl011", "arm,primecell";
                reg = <0x10050000 0x1000>;
                clocks = <&pclk>; 
                clock-names = "apb_pclk";
                interrupts = <0 3 0>;
            };*/
            dma@20020000 {
	    	    compatible = "arm,pl330", "arm,primecell";
	    	    reg = <0x20020000 0x1000>;
	    	    interrupt-names = "name";
	    	    interrupts = <0 10 0>;
                clocks = <&dmaclk>;
			    clock-names = "apb_pclk";
	        };
        };
    };
};